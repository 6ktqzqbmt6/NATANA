# 서버에서만 사용. 실제 값이 들어간 .env.local은 Git에 올리지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 로컬 개발 시 아래 주소. Vercel에서는 실제 배포 주소로 변경하세요.
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32 로 생성
NEXTAUTH_SECRET=
# Google Cloud > OAuth 웹 애플리케이션 자격 증명
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google에서 확인된 이메일만 허용. 쉼표로 구분. 비어 있으면 모두 거부.
ALLOWED_EMAILS=
